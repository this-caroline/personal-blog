---
import { getCollection, render } from "astro:content";

import ArticleLayout from "@layouts/ArticleLayout.astro";
import { createPublishedArticles, type PublishedArticle } from "@lib/writing";

interface Props {
  readonly article: PublishedArticle;
}

export async function getStaticPaths() {
  const articles = createPublishedArticles(await getCollection("writing"));
  return articles.map((article) => ({
    params: { slug: article.entry.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article.entry);
---

<ArticleLayout article={article}>
  <Content />
</ArticleLayout>
