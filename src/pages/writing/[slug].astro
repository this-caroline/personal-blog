---
import { getCollection, render } from "astro:content";

import { siteIdentity } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createBlogPostingJsonLd } from "@lib/jsonLd";
import { createPageMetadata } from "@lib/metadata";
import {
  createPublishedArticles,
  formatArticleDate,
  type PublishedArticle,
} from "@lib/writing";

interface Props {
  readonly article: PublishedArticle;
}

export async function getStaticPaths() {
  const articles = createPublishedArticles(await getCollection("writing"));

  return articles.map((article) => ({
    params: { slug: article.entry.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const frontmatter = article.entry.data;
const { Content } = await render(article.entry);
const metadata = createPageMetadata({
  pathname: article.url,
  title: frontmatter.title,
  description: frontmatter.description,
  type: "article",
  ...(frontmatter.image === undefined ? {} : { image: frontmatter.image }),
});
const imageUrl =
  frontmatter.image === undefined
    ? undefined
    : new URL(frontmatter.image, metadata.canonicalUrl);
const articleJsonLdInput = {
  canonicalUrl: metadata.canonicalUrl,
  title: frontmatter.title,
  description: frontmatter.description,
  publishedAt: frontmatter.publishedAt,
  ...(frontmatter.updatedAt === undefined
    ? {}
    : { updatedAt: frontmatter.updatedAt }),
  ...(imageUrl === undefined ? {} : { imageUrl }),
};
---

<BaseLayout
  metadata={metadata}
  jsonLd={[createBlogPostingJsonLd(articleJsonLdInput)]}
>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">Writing</p>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
      <dl class="article-meta">
        <div>
          <dt>Author</dt>
          <dd>{siteIdentity.name}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd>
            <time datetime={frontmatter.publishedAt.toISOString()}>
              {formatArticleDate(frontmatter.publishedAt)}
            </time>
          </dd>
        </div>
        {frontmatter.updatedAt !== undefined && (
          <div>
            <dt>Updated</dt>
            <dd>
              <time datetime={frontmatter.updatedAt.toISOString()}>
                {formatArticleDate(frontmatter.updatedAt)}
              </time>
            </dd>
          </div>
        )}
        <div>
          <dt>Reading time</dt>
          <dd>{article.readingMinutes} min read</dd>
        </div>
      </dl>
      {frontmatter.tags.length > 0 && (
        <ul class="tag-list" aria-label="Article tags">
          {frontmatter.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="article-body">
      <Content />
    </div>

    <footer class="author-note">
      <p>
        Written by <a href="/about">{siteIdentity.name}</a>, a{" "}
        {siteIdentity.professionalTitle.toLowerCase()} in{" "}
        {siteIdentity.location} working across architecture, infrastructure, and
        product-minded software.
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .author-note {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    padding: 1.25rem;
  }

  .article-page {
    max-width: 48rem;
  }

  .article-header {
    padding-block: 2rem;
  }

  .article-header h1 {
    font-size: clamp(2.5rem, 7vw, 4.6rem);
  }

  .article-header > p {
    color: var(--color-muted);
    font-size: 1.16rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-block: 1.5rem;
  }

  .article-meta div {
    display: grid;
    gap: 0.1rem;
  }

  .article-meta dt {
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .article-meta dd {
    margin: 0;
    font-weight: 700;
  }

  .article-body {
    font-size: 1.08rem;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin-block: 2.5rem 0.8rem;
  }

  .article-body :global(p),
  .article-body :global(li) {
    color: var(--color-muted);
  }

  .article-body :global(pre) {
    overflow-x: auto;
    border-radius: 8px;
    background: #16201d;
    color: #f8f7f3;
    padding: 1rem;
  }

  .article-body :global(code) {
    font-size: 0.92em;
  }

  .author-note {
    margin-block-start: 3rem;
  }
</style>
