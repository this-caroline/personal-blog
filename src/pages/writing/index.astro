---
import { getCollection } from "astro:content";

import ArticleSummary from "@components/ArticleSummary.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageMetadata } from "@lib/metadata";
import { createPublishedArticles } from "@lib/writing";

const metadata = createPageMetadata({
  pathname: "/writing",
  title: "Writing",
  description:
    "Notes by Caroline Marques on software engineering, architecture, infrastructure, local AI, and things she is learning.",
});
const articles = createPublishedArticles(await getCollection("writing"));
---

<BaseLayout metadata={metadata}>
  <div class="page-flow">
    <header class="page-header">
      <p class="eyebrow">Writing</p>
      <h1>Writing</h1>
      <p>
        Notes on software engineering, architecture, infrastructure, local AI,
        and things I'm learning.
      </p>
    </header>

    <section class="content-section" aria-label="Published articles">
      {articles.length === 0 ? (
        <div class="empty-state">
          <p class="story-label">Writing soon</p>
          <h2>The notebook is open.</h2>
          <p>
            I am working on field notes about local LLMs, deployment
            authentication, internationalization, and the small engineering
            lessons that are easy to lose if nobody writes them down.
          </p>
        </div>
      ) : (
        <div class="article-list">
          {articles.map((article) => (
            <ArticleSummary article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
