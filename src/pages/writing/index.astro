---
import { getCollection } from "astro:content";

import ArticleSummary from "@components/ArticleSummary.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageMetadata } from "@lib/metadata";
import { createPublishedArticles } from "@lib/writing";

const metadata = createPageMetadata({
  pathname: "/writing",
  title: "Writing",
  description: "Articles and notes by Caroline Marques.",
});
const articles = createPublishedArticles(await getCollection("writing"));
---

<BaseLayout metadata={metadata}>
  <div class="page-flow">
    <header class="page-header">
      <p class="eyebrow">Writing</p>
      <h1>Writing</h1>
    </header>

    <section class="content-section" aria-label="Published articles">
      {articles.length === 0 ? (
        <div class="empty-state">
          <h2>No published articles yet.</h2>
        </div>
      ) : (
        <div class="article-list">
          {articles.map((article) => (
            <ArticleSummary article={article} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
