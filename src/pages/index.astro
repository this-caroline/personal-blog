---
import EngineeringStories from "@components/home/EngineeringStories.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeWorkbench from "@components/home/HomeWorkbench.astro";
import { siteIdentity } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageMetadata } from "@lib/metadata";

const metadata = createPageMetadata({
  pathname: "/",
  description: `
    ${siteIdentity.name}, a software engineer in Munich. Production software, side projects, and other things occupying her brain.
  `.trim(),
});
---

<BaseLayout metadata={metadata}>
  <HomeHero />
  <HomeWorkbench />
  <EngineeringStories />
</BaseLayout>
