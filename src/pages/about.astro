---
import BaseLayout from "@layouts/BaseLayout.astro";
import { currentSnapshot } from "@config/current";
import { siteIdentity } from "@config/site";
import { createProfilePageJsonLd } from "@lib/jsonLd";
import { createPageMetadata } from "@lib/metadata";

const metadata = createPageMetadata({
  pathname: "/about",
  fullTitle: "About Caroline Marques | Software Engineer",
  description:
    "About Caroline Marques, a software engineer in Munich, Germany building backend-leaning full-stack products, cloud infrastructure, practical local AI tools, and maintainable systems.",
  type: "profile",
});

const profileFacts = [
  ["role", siteIdentity.professionalTitle],
  ["location", siteIdentity.location],
  ["bias", "backend-leaning full-stack"],
  ["currently", "local AI + grammar tools"],
  ["offline", "bouldering, games, books"],
] as const;

const buildingPrinciples = [
  {
    title: "Make complexity earn its place",
    description:
      "Architecture should solve a problem that actually exists. I like clear boundaries and boring solutions when boring solutions are enough.",
  },
  {
    title: "Production counts",
    description:
      "A feature is more than the happy path. Deployment, observability, authentication, migrations, and failure modes are part of the product too.",
  },
  {
    title: "Leave the code better for the next person",
    description:
      "Readable systems scale better than clever ones. Developer experience matters when it removes friction without hiding important trade-offs.",
  },
  {
    title: "Product details become architecture",
    description:
      "Internationalization, locale, authentication, and permissions eventually shape the system. Treating them as afterthoughts usually gets expensive.",
  },
] as const;

const practiceNotes = [
  {
    label: "Internationalization",
    description:
      "Led the rollout of Japanese for an international software product, from the first idea through implementation and delivery.",
  },
  {
    label: "Infrastructure",
    description:
      "Moved deployment authentication from long-lived AWS credentials to short-lived GitLab OIDC credentials.",
  },
  {
    label: "Security",
    description:
      "Worked directly with security and pentesting efforts connected to successful product certification.",
  },
  {
    label: "Product engineering",
    description:
      "Built features across backend, frontend, cloud, and mobile boundaries, close enough to see where the real product edges were.",
  },
] as const;

const currentInterests = currentSnapshot.entries.slice(0, 2);

const outsideSoftware = [
  {
    label: "Bouldering",
    title: "Climbing",
    description:
      "I climb a lot. You can usually find me working on V5s and V6s.",
  },
  {
    label: "Board games",
    title: "Tabletop Games",
    description:
      "I spend an unreasonable amount of time thinking about board games.",
    link: {
      label: "See what I've been playing ->",
      url: "https://boardgamegeek.com/profile/ex_emo",
    },
  },
  {
    label: "Last read",
    title: "Books",
    description: "Quarto de Despejo",
    detail: "Carolina Maria de Jesus",
  },
] as const;
---

<BaseLayout
  metadata={metadata}
  jsonLd={[createProfilePageJsonLd(metadata.canonicalUrl)]}
>
  <article class="about-page">
    <header class="about-hero">
      <div class="about-hero-copy">
        <p class="eyebrow">About</p>
        <h1>Caroline Marques</h1>
        <p class="about-intro">
          Hi, I'm Caroline. I'm a software engineer in Munich, Germany, usually
          working somewhere between backend systems, product development, and
          the infrastructure that keeps both running.
        </p>
        <p>
          I like software that still makes sense when someone opens the code six
          months later.
        </p>
      </div>

      <aside class="profile-window" aria-label="Caroline Marques profile">
        <div class="profile-window-bar">
          <span>caroline.profile</span>
          <span class="profile-window-light" aria-hidden="true"></span>
        </div>
        <dl class="profile-facts">
          {profileFacts.map(([name, value]) => (
            <div>
              <dt>{name}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </header>

    <section class="about-section short-version" aria-labelledby="short-title">
      <div class="section-heading">
        <p class="eyebrow">The short version</p>
        <h2 id="short-title">How I ended up here</h2>
      </div>
      <div class="short-version-copy">
        <p>
          I am a full-stack engineer with a backend bias. Most of the problems I
          enjoy live around APIs, services, cloud infrastructure,
          authentication, and product features that have to survive real
          production use.
        </p>
        <p>
          I am particularly interested in the points where those things meet. A
          feature is not really finished if deploying it is fragile, debugging
          it is miserable, or the next engineer has to reverse-engineer why it
          works.
        </p>
      </div>
    </section>

    <section
      class="about-section principles-section"
      aria-labelledby="build-title"
    >
      <div class="section-heading">
        <p class="eyebrow">How I like to build</p>
        <h2 id="build-title">Things I care about when building software</h2>
      </div>
      <div class="principle-grid">
        {buildingPrinciples.map((principle) => (
          <section
            class="principle-note"
            aria-labelledby={`principle-${principle.title.toLowerCase().replaceAll(" ", "-")}`}
          >
            <h3
              id={`principle-${principle.title.toLowerCase().replaceAll(" ", "-")}`}
            >
              {principle.title}
            </h3>
            <p>{principle.description}</p>
          </section>
        ))}
      </div>
    </section>

    <section
      class="about-section practice-section"
      aria-labelledby="practice-title"
    >
      <div class="section-heading">
        <p class="eyebrow">In practice</p>
        <h2 id="practice-title">A few places this has taken me</h2>
      </div>
      <ol class="practice-list">
        {practiceNotes.map((note) => (
          <li>
            <span>{note.label}</span>
            <p>{note.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section
      class="about-section current-section"
      aria-labelledby="current-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Currently</p>
        <h2 id="current-title">Occupying my brain</h2>
      </div>
      <div class="current-grid">
        {currentInterests.map((interest) => (
          <article class="current-note">
            <p class="status-label">{interest.label}</p>
            <h3>{interest.title}</h3>
            <p>{interest.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="about-section outside-section"
      aria-labelledby="outside-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Outside software</p>
        <h2 id="outside-title">When I'm not at a keyboard</h2>
      </div>
      <div class="outside-grid">
        {outsideSoftware.map((snapshot) => (
          <article class="outside-tile">
            <p class="status-label">{snapshot.label}</p>
            <h3>{snapshot.title}</h3>
            <p>{snapshot.description}</p>
            {"detail" in snapshot && (
              <p class="outside-detail">{snapshot.detail}</p>
            )}
            {"link" in snapshot && (
              <a href={snapshot.link.url}>{snapshot.link.label}</a>
            )}
          </article>
        ))}
      </div>
      <p class="side-project-note">
        I also have a tendency to turn small annoyances into side projects,
        which is how the local LLM setup and grammar assistant happened.
      </p>
    </section>

    <section class="about-section links-section" aria-labelledby="links-title">
      <div class="section-heading">
        <p class="eyebrow">Elsewhere</p>
        <h2 id="links-title">Keep exploring</h2>
      </div>
      <div class="about-links" aria-label="More about Caroline Marques">
        <a href="/projects">Projects</a>
        <a href="/writing">Writing</a>
        <a href="https://boardgamegeek.com/profile/ex_emo">BoardGameGeek</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: 4.5rem;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(18rem, 1.45fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: 3rem 1.5rem;
  }

  .about-hero-copy {
    max-width: 48rem;
  }

  .about-hero-copy p {
    color: var(--color-muted);
    font-size: 1.12rem;
  }

  .about-intro {
    margin-block-start: 1.25rem;
  }

  .profile-window {
    border: 1px solid var(--color-text);
    border-radius: 6px;
    background:
      linear-gradient(90deg, rgb(11 92 85 / 10%) 1px, transparent 1px) 0 0 /
        12px 12px,
      var(--color-paper-warm);
    box-shadow:
      8px 8px 0 var(--color-warm-muted),
      var(--shadow-subtle);
    overflow: hidden;
  }

  .profile-window-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-text);
    background: var(--color-accent-strong);
    color: #ffffff;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    padding: 0.55rem 0.75rem;
    text-transform: uppercase;
  }

  .profile-window-light {
    width: 0.75rem;
    height: 0.75rem;
    background: #b8d46b;
    box-shadow: inset 0 0 0 2px rgb(22 32 29 / 18%);
  }

  .profile-facts {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 1rem;
  }

  .profile-facts div {
    display: grid;
    grid-template-columns: 6.6rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .profile-facts dt,
  .status-label,
  .practice-list span {
    color: var(--color-warm);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .profile-facts dd {
    margin: 0;
    font-weight: 750;
  }

  .about-section {
    display: grid;
    gap: 1.5rem;
  }

  .short-version {
    grid-template-columns: minmax(14rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    border-block: 1px solid var(--color-border);
    padding-block: 3rem;
  }

  .short-version-copy {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .short-version-copy p,
  .principle-note p,
  .practice-list p,
  .current-note p,
  .outside-tile p,
  .side-project-note {
    color: var(--color-muted);
  }

  .principles-section::before,
  .outside-section::before {
    content: "";
    display: block;
    width: min(16rem, 55vw);
    height: 0.55rem;
    background: linear-gradient(
        90deg,
        var(--color-accent-strong) 50%,
        transparent 0
      )
      0 0 / 0.7rem 0.7rem;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1rem;
    align-items: start;
  }

  .principle-note {
    border-left: 4px solid var(--color-warm-muted);
    background: linear-gradient(180deg, rgb(255 255 255 / 72%) 0, transparent);
    padding: 1rem 1.1rem;
  }

  .principle-note:nth-child(2),
  .principle-note:nth-child(4) {
    margin-block-start: 1.5rem;
  }

  .principle-note h3,
  .current-note h3,
  .outside-tile h3 {
    font-size: 1.25rem;
  }

  .practice-section {
    border-block: 1px solid var(--color-border);
    padding-block: 3rem;
  }

  .practice-list {
    counter-reset: practice;
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .practice-list li {
    counter-increment: practice;
    display: grid;
    grid-template-columns: 3.25rem minmax(9rem, 0.42fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .practice-list li::before {
    content: "0" counter(practice);
    color: var(--color-accent-strong);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-weight: 800;
  }

  .practice-list p {
    margin: 0;
  }

  .current-grid,
  .outside-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .current-note,
  .outside-tile {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background:
      linear-gradient(90deg, rgb(15 118 110 / 8%) 1px, transparent 1px) 0 0 /
        18px 18px,
      var(--color-surface);
    padding: 1.25rem;
  }

  .current-note:first-child {
    background:
      linear-gradient(90deg, rgb(15 118 110 / 10%) 1px, transparent 1px) 0 0 /
        18px 18px,
      var(--color-paper-warm);
    box-shadow: var(--shadow-pixel);
  }

  .outside-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .outside-tile {
    min-height: 13rem;
    background:
      linear-gradient(135deg, transparent 0 78%, rgb(232 208 186 / 55%) 78%),
      var(--color-surface);
  }

  .outside-tile:first-child {
    background:
      radial-gradient(
        circle at 18% 22%,
        var(--color-warm-muted) 0 0.35rem,
        transparent 0.4rem
      ),
      radial-gradient(
        circle at 72% 62%,
        rgb(15 118 110 / 20%) 0 0.42rem,
        transparent 0.47rem
      ),
      var(--color-surface);
  }

  .outside-detail {
    color: var(--color-warm);
    font-weight: 750;
  }

  .side-project-note {
    max-width: 42rem;
    border-left: 4px solid var(--color-warm-muted);
    padding-inline-start: 1rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-links a {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface-muted);
    padding: 0.55rem 0.75rem;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .about-page {
      gap: 3.25rem;
    }

    .about-hero,
    .short-version,
    .principle-grid,
    .current-grid,
    .outside-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .profile-facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }

    .principle-note:nth-child(2),
    .principle-note:nth-child(4) {
      margin-block-start: 0;
    }

    .practice-list li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .practice-list p {
      grid-column: 2;
    }
  }
</style>
