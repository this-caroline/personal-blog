---
import ProjectCard from "@components/ProjectCard.astro";
import { projects } from "@config/projects";
import { siteIdentity } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageMetadata } from "@lib/metadata";

import styles from "./projects.module.css";

const metadata = createPageMetadata({
  pathname: "/projects",
  title: "Projects",
  description: `In-progress projects and technical experiments by ${siteIdentity.name}, including local AI infrastructure and a personal grammar assistant.`,
});
---

<BaseLayout metadata={metadata}>
  <div class="page-flow">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Projects</h1>
      <p>
        Things I'm building because I needed them, wanted to understand them, or
        couldn't leave them alone.
      </p>
    </header>

    <section class="content-section" aria-label="Project list">
      <div class:list={["project-list", styles["project-list"]]}>
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
