---
import ProjectCard from "@components/ProjectCard.astro";
import { projects } from "@config/projects";
import { siteIdentity } from "@config/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageMetadata } from "@lib/metadata";

const metadata = createPageMetadata({
  pathname: "/projects",
  title: "Projects",
  description: `In-progress projects and technical experiments by ${siteIdentity.name}, including local AI infrastructure and a personal grammar assistant.`,
});
---

<BaseLayout metadata={metadata}>
  <div class="page-flow">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Projects</h1>
      <p>
        A workbench for substantial builds, experiments, and weird ideas worth
        following. Some things are in progress, some are exploratory, and some
        may eventually be paused. That is part of the point.
      </p>
    </header>

    <aside class="workbench-note">
      <span aria-hidden="true"></span>
      <p>
        This is a curated workbench, not a polished product shelf or a raw
        GitHub dump.
      </p>
    </aside>

    <section class="content-section" aria-label="Project list">
      <div class="project-list">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .project-list {
    display: grid;
    gap: 1rem;
  }

  .project-list {
    grid-template-columns: minmax(0, 1fr);
  }

  .workbench-note {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    max-width: 46rem;
    border: 1px dashed var(--color-border);
    background: var(--color-paper-warm);
    padding: 0.85rem 1rem;
  }

  .workbench-note > span {
    flex: 0 0 auto;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-warm);
    box-shadow: 0.35rem 0.35rem 0 var(--color-warm-muted);
  }

  .workbench-note p {
    color: var(--color-muted);
    margin: 0;
  }
</style>
