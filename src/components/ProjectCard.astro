---
import type { Project } from "@config/projects";

import styles from "./ProjectCard.module.css";

interface Props {
  readonly project: Project;
}

const { project } = Astro.props;
---

<article class:list={["project-card", styles["project-card"]]}>
  <div class:list={["project-card-header", styles["project-card-header"]]}>
    <h2>{project.name}</h2>
    <p class:list={["project-status", styles["project-status"]]}>
      <span aria-hidden="true"></span>
      {project.status}
    </p>
  </div>
  <p>{project.detail.description}</p>
  {project.detail.focusAreas.length > 0 && (
    <ul class="tag-list" aria-label={`${project.name} current focus`}>
      {project.detail.focusAreas.map((focusArea) => (
        <li>{focusArea}</li>
      ))}
    </ul>
  )}
  {project.detail.benchNotes.length > 0 && (
    <div class:list={["bench-notes", styles["bench-notes"]]}>
      <p>On the bench</p>
      <ul class:list={["check-list", styles["check-list"]]}>
        {project.detail.benchNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )}
</article>
