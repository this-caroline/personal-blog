---
import { engineeringStories } from "@config/engineering-stories";

import styles from "./sections.module.css";

const practiceNotes = [
  ...engineeringStories.map((story) => story.about),
  {
    label: "Product engineering",
    description:
      "Built features across backend, frontend, cloud, and mobile boundaries, close enough to see where the real product edges were.",
  },
];
---

<section
  class:list={[
    "about-section practice-section",
    styles["about-section"],
    styles["practice-section"],
  ]}
  aria-labelledby="practice-title"
>
  <div class="section-heading">
    <p class="eyebrow">In practice</p>
    <h2 id="practice-title">A few places this has taken me</h2>
  </div>
  <ol class:list={["practice-list", styles["practice-list"]]}>
    {practiceNotes.map((note) => (
      <li>
        <span>{note.label}</span>
        <p>{note.description}</p>
      </li>
    ))}
  </ol>
</section>
