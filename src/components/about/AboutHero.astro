---
import { siteIdentity } from "@config/site";
import profileWindow from "@styles/profile-window.module.css";

import styles from "./sections.module.css";

const profileFacts = [
  ["based_in", "Munich 🇩🇪"],
  ["originally", "Brazil 🇧🇷"],
  ["climbing", "V5–V6"],
  ["tabletop", "probably teaching someone a board game"],
  ["headphones", "metalcore"],
] as const;
---

<header class:list={["about-hero", styles["about-hero"]]}>
  <div class:list={["about-hero-copy", styles["about-hero-copy"]]}>
    <h1>Omg, hiii :D</h1>
    <p class:list={["about-intro", styles["about-intro"]]}>
      I'm Caroline, a Brazilian software engineer living in Munich.
    </p>
    <p>
      I tend to end up in the awkward spaces between things: backend and
      product, feature development and production, code and infrastructure.
    </p>
    <p>
      I enjoy tracking down problems across services and figuring out how the
      pieces interact.
    </p>
    <p>
      I prefer straightforward architecture that fits the problem. I don't
      really consider a feature finished if deploying it is terrifying or nobody
      knows how to debug it six months later.
    </p>
    <p>
      Fun fact: I had a Naruto fan-blog when I was 12 and I've been building
      things on the internet ever since :)
    </p>
  </div>

  <aside
    class:list={["profile-window", profileWindow.window]}
    aria-label={`${siteIdentity.name} profile`}
  >
    <div class:list={["profile-window-bar", profileWindow.titleBar]}>
      <span>caroline.profile</span>
      <span
        class:list={["profile-window-light", styles["profile-window-light"]]}
        aria-hidden="true"
      ></span>
    </div>
    <dl class:list={["profile-facts", styles["profile-facts"]]}>
      {profileFacts.map(([name, value]) => (
        <div>
          <dt>{name}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </aside>
</header>
