---
import { siteIdentity } from "@config/site";
import profileWindow from "@styles/profile-window.module.css";

import styles from "./sections.module.css";

const profileFacts = [
  ["role", siteIdentity.professionalTitle],
  ["location", siteIdentity.location],
  ["bias", "backend-leaning full-stack"],
  ["currently", "local AI + grammar tools"],
  ["offline", "bouldering, games, books"],
] as const;
---

<header class:list={["about-hero", styles["about-hero"]]}>
  <div class:list={["about-hero-copy", styles["about-hero-copy"]]}>
    <p class="eyebrow">About</p>
    <h1>{siteIdentity.name}</h1>
    <p class:list={["about-intro", styles["about-intro"]]}>
      Hi, I'm Caroline. I'm a {siteIdentity.professionalTitle.toLowerCase()} in{" "}
      {siteIdentity.location}, usually working somewhere between backend
      systems, product development, and the infrastructure that keeps both
      running.
    </p>
    <p>
      I like software that still makes sense when someone opens the code six
      months later.
    </p>
  </div>

  <aside
    class:list={["profile-window", profileWindow.window]}
    aria-label={`${siteIdentity.name} profile`}
  >
    <div class:list={["profile-window-bar", profileWindow.titleBar]}>
      <span>caroline.profile</span>
      <span
        class:list={["profile-window-light", styles["profile-window-light"]]}
        aria-hidden="true"
      ></span>
    </div>
    <dl class:list={["profile-facts", styles["profile-facts"]]}>
      {profileFacts.map(([name, value]) => (
        <div>
          <dt>{name}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </aside>
</header>
