---
import { formatArticleDate, type PublishedArticle } from "@lib/writing";

import styles from "./sections.module.css";

interface Props {
  readonly articles: readonly PublishedArticle[];
}
const { articles } = Astro.props;
const upcomingNotes = [
  {
    category: "Local AI",
    title: "Local LLMs at home",
    description: "Models, context limits, and what works in practice.",
  },
  {
    category: "Engineering",
    title: "Lessons from OIDC and internationalization",
  },
  {
    category: "Project log",
    title: "Building a personal grammar assistant",
  },
];
---

<section
  class:list={["content-section writing-section", styles["writing-section"]]}
  aria-labelledby="latest-writing-title"
>
  <div class="section-heading">
    <h2 id="latest-writing-title">Notes from the workbench</h2>
  </div>
  <div class={styles["notebook-list"]}>
    {articles.length === 0
      ? upcomingNotes.map((note) => (
          <article class={styles["notebook-entry"]}>
            <p class={styles["note-metadata"]}>Coming soon · {note.category}</p>
            <h3>{note.title}</h3>
            {note.description && (
              <p class={styles["note-description"]}>{note.description}</p>
            )}
          </article>
        ))
      : articles.map((article) => (
          <article class={styles["notebook-entry"]}>
            <p class={styles["note-metadata"]}>
              <time datetime={article.entry.data.publishedAt.toISOString()}>
                {formatArticleDate(article.entry.data.publishedAt)}
              </time>
              {article.entry.data.draft && " · Draft"}
              {article.entry.data.tags[0] && ` · ${article.entry.data.tags[0]}`}
            </p>
            <h3>
              <a class={styles["note-link"]} href={article.url}>
                <span>{article.entry.data.title}</span>
                <span class={styles.arrow} aria-hidden="true">
                  →
                </span>
              </a>
            </h3>
            <p class={styles["note-description"]}>
              {article.entry.data.description}
            </p>
          </article>
        ))}
  </div>
  <p class="section-link">
    <a href="/writing">Visit the writing desk →</a>
  </p>
</section>
