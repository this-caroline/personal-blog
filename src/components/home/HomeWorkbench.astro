---
import { projects } from "@config/projects";

import styles from "./sections.module.css";
import WorkbenchCard from "./WorkbenchCard.astro";
---

<section
  class:list={[
    "content-section workbench-section",
    styles["workbench-section"],
  ]}
  aria-labelledby="building-title"
>
  <div class="section-heading">
    <h2 id="building-title">What I'm building</h2>
  </div>
  <div class:list={["workbench-grid", styles["workbench-grid"]]}>
    {projects.map((project, index) => (
      <WorkbenchCard project={project} featured={index === 0} />
    ))}
  </div>
  <p class="section-link">
    <a href="/projects">See all projects →</a>
  </p>
</section>
