---
import { formatArticleDate, type PublishedArticle } from "@lib/writing";

interface Props {
  readonly article: PublishedArticle;
  readonly headingLevel?: "h2" | "h3";
}

const { article, headingLevel = "h2" } = Astro.props;
const frontmatter = article.entry.data;
const Heading = headingLevel;
---

<article class="article-summary">
  <p class="article-date">
    <time datetime={frontmatter.publishedAt.toISOString()}>
      {formatArticleDate(frontmatter.publishedAt)}
    </time>
  </p>
  <Heading>
    <a href={article.url}>{frontmatter.title}</a>
  </Heading>
  <p>{frontmatter.description}</p>
  {frontmatter.tags.length > 0 && (
    <ul class="tag-list" aria-label="Article tags">
      {frontmatter.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .article-summary {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    padding: 1.25rem;
  }

  .article-summary:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-pixel);
    transform: translate(-1px, -1px);
  }

  .article-summary p {
    color: var(--color-muted);
  }

  .article-summary h2 {
    font-size: 1.35rem;
  }

  .article-date {
    color: var(--color-warm);
    font-size: 0.9rem;
    font-weight: 750;
    margin: 0;
  }

  .article-summary {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .article-summary h2 {
    margin: 0;
  }

  .article-summary h2 a {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
  }

  .article-summary h2 a:hover {
    color: var(--color-accent-strong);
  }
</style>
