---
import { siteIdentity } from "@config/site";

const currentYear = 2026;
const footerLinks = [
  ...siteIdentity.profiles,
  { label: "RSS", url: "/rss.xml" },
] as const;
---

<footer class="site-footer">
  <div>
    <p class="footer-name">{siteIdentity.name}</p>
    <p>{siteIdentity.professionalTitle}</p>
    <p>{siteIdentity.location}</p>
  </div>
  <div class="footer-secondary">
    <nav aria-label="Footer links">
      {footerLinks.map((link) => (
        <a href={link.url} rel={link.url.startsWith("http") ? "me" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <p>
      &copy; {currentYear} {siteIdentity.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    align-items: center;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    padding-block: 1.5rem 2rem;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-name {
    color: var(--color-text);
    font-weight: 800;
  }

  .footer-secondary {
    display: grid;
    gap: 0.5rem;
    justify-items: end;
  }

  .footer-note {
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-secondary {
      justify-items: start;
    }
  }
</style>
