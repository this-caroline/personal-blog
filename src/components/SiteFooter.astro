---
import { siteIdentity } from "@config/site";

import styles from "./SiteFooter.module.css";

const currentYear = new Date().getUTCFullYear();
const footerLinks = [
  ...siteIdentity.profiles,
  { label: "RSS", url: "/rss.xml" },
] as const;
---

<footer class:list={["site-footer", styles["site-footer"]]}>
  <div>
    <p class:list={["footer-name", styles["footer-name"]]}>
      {siteIdentity.name}
    </p>
    <p>{siteIdentity.professionalTitle}</p>
    <p>{siteIdentity.location}</p>
  </div>
  <div class:list={["footer-secondary", styles["footer-secondary"]]}>
    <nav aria-label="Footer links">
      {footerLinks.map((link) => (
        <a href={link.url} rel={link.url.startsWith("http") ? "me" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <p>
      &copy; {currentYear} {siteIdentity.name}
    </p>
  </div>
</footer>
