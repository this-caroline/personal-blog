---
import { navigationLinks, siteIdentity } from "@config/site";

import styles from "./SiteHeader.module.css";

const currentPath = Astro.url.pathname;

const isCurrentPage = (path: string): boolean => {
  if (path === "/") {
    return currentPath === "/";
  }

  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class:list={["site-header", styles["site-header"]]}>
  <a
    class:list={["identity-link", styles["identity-link"]]}
    href="/"
    aria-label={`${siteIdentity.name} homepage`}
  >
    <span>{siteIdentity.name}</span>
    <span>{siteIdentity.professionalTitle}</span>
  </a>
  <nav
    class:list={["primary-nav", styles["primary-nav"]]}
    aria-label="Primary navigation"
  >
    {navigationLinks.map((link) => (
      <a
        href={link.pathname}
        aria-current={isCurrentPage(link.pathname) ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
