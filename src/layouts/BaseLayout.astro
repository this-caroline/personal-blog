---
import DocumentHead from "@components/metadata/DocumentHead.astro";
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { createGlobalJsonLd, type JsonLdNode } from "@lib/jsonLd";
import type { PageMetadata } from "@lib/metadata";

import "../styles/global.css";

interface Props {
  readonly metadata: PageMetadata;
  readonly jsonLd?: readonly JsonLdNode[];
}

const { metadata, jsonLd = [] } = Astro.props;
const jsonLdGraphs = [createGlobalJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <DocumentHead metadata={metadata} jsonLdGraphs={jsonLdGraphs} />
  <body>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
