{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@config/*": ["./src/config/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"]
    },
    "types": ["vitest/globals", "astro/client"]
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "eslint.config.js",
    "prettier.config.js",
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["dist"]
}
